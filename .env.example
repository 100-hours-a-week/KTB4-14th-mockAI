# 최소 32자 이상. AI 서버를 호출하는 백엔드와 같은 값을 사용합니다.
AUDIGO_API_TOKEN=
OPEN_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 카카오 장소 검색·길찾기·블로그 검색
KAKAO_REST_API_KEY=

# Swagger(/docs, /redoc, /openapi.json) 접근용 Basic 인증. 비밀번호는 8자 이상.
# 둘 중 하나라도 비어 있으면 문서 페이지를 열지 않습니다.
DOCS_USERNAME=
DOCS_PASSWORD=

# SQS 큐 워커. 두 큐 URL이 모두 있을 때만 워커가 켜집니다.
# 자격 증명은 AWS 기본 체인(운영: ECS Task Role, 로컬: 프로필·환경변수)을 씁니다.
AWS_REGION=ap-northeast-2
AUDIGO_AI_JOB_QUEUE_URL=
AUDIGO_AI_RESULT_QUEUE_URL=
# live(기본) | mock(외부 AI 호출 없음) | off(큐 소비 안 함)
# 다른 서버의 실제 Worker는 이 설정으로 중지되지 않습니다. 같은 큐에서 동시 실행하지 마세요.
AUDIGO_AI_QUEUE_WORKER_MODE=live
# 프로세스당 동시 처리 수(1~32). 기본 1은 기존 순차 처리를 유지합니다.
AUDIGO_AI_QUEUE_WORKER_CONCURRENCY=1
# SQS Mock 정상 작업의 최소 전체 생성 시간(초). 큐 대기·전송·BE 저장 시간은 제외합니다.
MOCK_JOB_DELAY_SECONDS=30

# /mock HTTP 경로 전용 지연. SQS Mock은 MOCK_JOB_DELAY_SECONDS를 사용합니다.
# 단계 이벤트 사이 대기 시간(초)
MOCK_STAGE_DELAY_SECONDS=1
# success | fail_place | fail_stay | fail_route | unavailable | drop
# HTTP에서는 X-Mock-Scenario 헤더가 우선합니다. SQS Mock은 이 환경변수만 사용합니다.
MOCK_SCENARIO=success

# 매칭 API 후보 상한. 초기 구현 기본값이며 BE 연동 시 조정합니다.
# 초과하면 후보를 자르지 않고 HTTP 422를 반환합니다.
MATCHING_MAX_CANDIDATES=1000
# JSON 디코딩 전 적용하는 본문 크기 제한(바이트). 초기값 2MiB.
MATCHING_MAX_BODY_BYTES=2097152
