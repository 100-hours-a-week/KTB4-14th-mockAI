# 최소 32자 이상. AI 서버를 호출하는 백엔드와 같은 값을 사용합니다.
AUDIGO_API_TOKEN=
OPEN_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 카카오 장소 검색·길찾기·블로그 검색
KAKAO_REST_API_KEY=

# /mock 경로 전용
# 단계 이벤트 사이 대기 시간(초)
MOCK_STAGE_DELAY_SECONDS=1
# success | fail_place | fail_stay | fail_route | unavailable | drop
# 요청 헤더 X-Mock-Scenario가 있으면 헤더 값이 우선합니다.
MOCK_SCENARIO=success
